# 复制为 .env 后填写，docker compose 会自动读取
# 生成随机密码/密钥建议: openssl rand -base64 32

# ---------- 数据库 ----------
DB_NAME=wts
DB_USERNAME=wts
DB_PASSWORD=请改成强密码
DB_ROOT_PASSWORD=请改成强密码
DB_PORT=3306

# ---------- 后端 ----------
SERVER_PORT=8080
JWT_SECRET=请改成至少32字节的随机串

# ---------- 局域网访问控制 ----------
# 是否启用局域网访问限制（机房部署建议 true）
LAN_ACCESS_ENABLED=true
# 自动放行服务器所在 /24 网段
LAN_AUTO_SAME_SUBNET=true
# 手动追加允许的网段，逗号分隔，如 192.168.1.0/24,10.10.0.0/16
LAN_ALLOWED_CIDRS=

# ---------- 其他 ----------
TZ=Asia/Shanghai
